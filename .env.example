# Copy to .env locally or set these values in the production host's environment.
# Never commit real credentials or keys.

SECRET_KEY=replace-with-a-long-random-secret
TIME_ZONE=Africa/Kampala

DB_ENGINE=django.db.backends.mysql
DB_NAME=replace-with-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_INIT_COMMAND=SET NAMES 'utf8mb4'

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace-with-smtp-host
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=replace-with-sender-address
